# ---------------------------------------------------------------------------
# HairGPT backend environment. Copy to `.env` and adjust. Safe defaults let the
# MVP run with NO Postgres, NO S3, NO ML stack, and NO external LLM.
# ---------------------------------------------------------------------------

# App
HAIRGPT_ENV=dev
SECRET_KEY=change-me-in-production-please-32chars-min
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000

# Database
# Dev default (works immediately):
DATABASE_URL=sqlite:///./hairgpt.db
# Production (PostgreSQL + pgvector):
# DATABASE_URL=postgresql+psycopg://hairgpt:hairgpt@localhost:5432/hairgpt

# Object storage. Default: local encrypted-at-rest disk under ./storage
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_DIR=./storage
# S3 (STORAGE_BACKEND=s3):
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=hairgpt
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1

# Envelope encryption key for stored images (Fernet/base64; generated if unset in dev)
IMAGE_ENCRYPTION_KEY=

# Computer vision
CV_BACKEND=mock                  # mock | torch
CV_MODEL_DIR=./models

# RAG
EMBEDDING_PROVIDER=hashing       # hashing | sentence_transformer
EMBEDDING_DIM=768
RAG_TOP_K=5

# LLM (explanation layer only — never the primary diagnostic mechanism)
LLM_PROVIDER=mock                # mock | anthropic
LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# Safety
SAFETY_STRICT=true               # fail-safe to more cautious verdict on errors
