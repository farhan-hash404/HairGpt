# ---------------------------------------------------------------------------
# HairGPT backend environment. Copy to `.env` and adjust. Safe defaults let the
# MVP run with NO Postgres, NO S3, NO ML stack, and NO external LLM.
# ---------------------------------------------------------------------------

# App
HAIRGPT_ENV=dev
SECRET_KEY=change-me-in-production-please-32chars-min
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000

# Database
# Dev default (works immediately):
DATABASE_URL=sqlite:///./hairgpt.db
# Production (PostgreSQL + pgvector):
# DATABASE_URL=postgresql+psycopg://hairgpt:hairgpt@localhost:5432/hairgpt

# Object storage. Default: local encrypted-at-rest disk under ./storage
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_DIR=./storage
# S3 (STORAGE_BACKEND=s3):
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=hairgpt
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1

# Envelope encryption key for stored images (Fernet/base64; generated if unset in dev)
IMAGE_ENCRYPTION_KEY=

# Computer vision
CV_BACKEND=mock                  # mock | torch
CV_MODEL_DIR=./models

# RAG — evidence corpus built by `python -m app.rag.scraper.run`
EMBEDDING_PROVIDER=onnx_minilm   # onnx_minilm (real, CPU, no PyTorch) | hashing (tests) | sentence_transformer
EMBEDDING_DIM=384
RAG_TOP_K=5
CORPUS_FILE=./data/corpus/documents.jsonl
CHROMA_DIR=./data/chroma
RAG_CROSS_ENCODER=true           # local ONNX cross-encoder rerank (best on the benchmark)
RAG_MIN_RELEVANCE=0.43           # abstain only if cosine is below this...
RAG_MIN_CE_LOGIT=-5.0            # ...AND the cross-encoder logit is below this

# LLM (explanation, reranking, judging — never the primary diagnostic mechanism)
# "auto" uses the first provider that has a key; with none, HairGPT runs its
# deterministic extractive path, which quotes sources verbatim and cannot hallucinate.
LLM_PROVIDER=auto                # auto | gemini | openai | anthropic | bedrock | none
# LLM_MODEL=                     # optional override of the chosen provider's default model
# GEMINI_API_KEY=                # free, no card: https://aistudio.google.com  (default model gemini-2.5-flash)
# OPENAI_API_KEY=                # default model gpt-5-mini
# ANTHROPIC_API_KEY=             # default model claude-sonnet-5
# BEDROCK_MODEL_ID=              # AWS Bedrock; uses standard AWS credentials
# AWS_REGION=us-east-1
LLM_TIMEOUT_S=6                  # latency budget for synchronous requests
LLM_MAX_REVISIONS=1              # regenerations allowed when the judge rejects an answer

# Safety
SAFETY_STRICT=true               # fail-safe to more cautious verdict on errors
