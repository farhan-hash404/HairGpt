# --- Secrets & local config (NEVER commit) ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- User data / medical images (NEVER commit) ---
backend/storage/
backend/*.db
backend/*.db-journal
backend/*.sqlite3

# --- ML model weights (never commit) ---
# Anchored on purpose. A bare "models/" also matched backend/app/models/ — the
# SQLAlchemy source package — which silently kept it out of git.
/models/
/backend/models/*
!/backend/models/manifest.example.json

# --- Generated RAG / evaluation artefacts ---
backend/data/corpus/raw/
backend/data/chroma/
backend/mlartifacts/
backend/mlruns/
backend/evaluation/test_images/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Node / Next.js ---
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# --- Editors / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json
